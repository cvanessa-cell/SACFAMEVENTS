# Supabase Postgres (primary DB).
# DATABASE_URL = transaction pooler (port 6543, pgbouncer=true). Used by the app at runtime.
# DIRECT_URL  = session pooler (port 5432). Used by `prisma migrate` / `prisma db push`.
# (We use the session pooler URL — not db.<ref>.supabase.co:5432 — because the direct host is IPv6-only on most plans.)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Supabase auth / realtime / storage (client-safe + server-only)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Legacy name used in some Supabase docs/snippets:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only — never commit; bypasses RLS. Use only for trusted server jobs.
SUPABASE_SERVICE_ROLE_KEY=""

AIRTABLE_API_KEY=""
AIRTABLE_BASE_ID=""
AIRTABLE_SOURCES_TABLE="Family Event Sources"
AIRTABLE_EVENTS_TABLE="Family Events"
AIRTABLE_VENUES_TABLE="Family Event Venues"
AIRTABLE_CATEGORIES_TABLE="Family Event Categories"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3333/api/calendar/callback"
# Fallback calendar id for newly connected accounts. Per-account default
# calendar can be changed at /settings; this is just the initial value used
# when an account is freshly connected.
GOOGLE_CALENDAR_ID="primary"

# Optional: Google Maps Embed API key. Without it, event review cards still
# show a Google Maps text link, but the inline iframe map preview is disabled.
# Restrict the key in Google Cloud Console to:
#   - HTTP referrers: your app's domain (e.g. http://localhost:3333/*)
#   - APIs: "Maps Embed API" only
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=""

OPENAI_API_KEY=""
OPENAI_WEBHOOK_SECRET=""
OPENAI_MODEL="gpt-5.5"
SLACK_WEBHOOK_URL=""
SLACK_SIGNALS_ENABLED="false"
SLACK_AUTO_DECISION_ENABLED="true"
SLACK_DECISION_FAILED_CHECKS_THRESHOLD="3"
SLACK_DECISION_AI_FAILED_THRESHOLD="2"
SLACK_DECISION_REVIEW_BACKLOG_THRESHOLD="25"
SLACK_DECISION_COOLDOWN_HOURS="24"
SLACK_DECISION_PAUSE_AFTER_INACTIVE_DAYS="3"

ZAPIER_WEBHOOK_URL=""
ZAPIER_WEBHOOK_SECRET=""
ZAPIER_ENABLED="true"

APP_BASE_URL="http://localhost:3333"

# Admin console protection (HTTP Basic Auth).
# Leave empty to disable auth (open access for local dev).
ADMIN_PASSWORD=""

CRON_SECRET=""

# Firecrawl — used to fetch JS-rendered / anti-bot-protected pages like
# Facebook public pages. Without this, sources with fetchStrategy="facebook_public"
# (or "firecrawl") will fail with a clear error message. Get a key at
# https://firecrawl.dev (free tier available).
FIRECRAWL_API_KEY=""

EVENT_SOURCE_CHECK_BATCH_SIZE="20"
EVENT_SOURCE_DEFAULT_CHECK_INTERVAL_MINUTES="360"
EVENT_EXTRACTION_AUTO_APPROVE_CONFIDENCE="0.88"
EVENT_TIMEZONE="America/Los_Angeles"
DEFAULT_TIMEZONE="America/Los_Angeles"
DEFAULT_REGION="Sacramento / Placer"
DEFAULT_SEARCH_RADIUS_MILES="60"

# --- SacFam AI Source Agent (admin-triggered OpenAI source research + event monitoring) ---
# Feature flags. Set both to "false" to fully disable the agent without removing code.
SACFAM_AI_SOURCE_AGENT_ENABLED="true"
SACFAM_AI_EVENT_MONITOR_ENABLED="true"
# Optional override for the model used by the source-research agent. Falls back to
# SACFAM_SOURCE_AGENT_MODEL, then OPENAI_MODEL.
OPENAI_SOURCE_RESEARCH_MODEL=""
# Legacy/internal name used by the existing agent implementation.
SACFAM_SOURCE_AGENT_MODEL=""
# Airtable writes are server-side only. When false, runs/candidates stay in Prisma
# and API/UI surfaces show clear configuration messages instead of throwing.
SACFAM_AIRTABLE_WRITE_ENABLED="true"
# Hard cap on the number of source candidates requested per research run.
SACFAM_SOURCE_AGENT_MAX_SOURCES="125"
# When "true", research/monitor runs persist runs + candidates but never auto-import
# into the live EventSource / FamilyEvent tables. Set "true" to require manual approval only.
SACFAM_SOURCE_AGENT_DRY_RUN="false"
# Keep Prisma run/candidate rows as the local audit mirror while Airtable is used
# for human review and MCP workflows.
SACFAM_SOURCE_RESEARCH_PRISMA_MIRROR="true"

# --- ChatGPT OpenAI Apps SDK MCP connector (SacFamEvents Daily Event Finder) ---
SACFAM_OPENAI_APP_ENABLED="true"
PUBLIC_APP_BASE_URL=""
# Production HTTPS origin for MCP URL: ${PUBLIC_APP_BASE_URL}/mcp

# --- Daily OpenAI web event discovery (Airtable Family Events as Need Review) ---
SACFAM_DAILY_WEB_EVENT_DISCOVERY_ENABLED="true"
SACFAM_DAILY_WEB_EVENT_DISCOVERY_DRY_RUN="true"
SACFAM_DAILY_EVENT_LIMIT="9"
SACFAM_DAILY_EVENT_LOOKAHEAD_DAYS="14"
OPENAI_DAILY_EVENT_MODEL="gpt-5.5"
AIRTABLE_FAMILY_EVENT_SOURCES_TABLE="Family Event Sources"
AIRTABLE_FAMILY_EVENTS_TABLE="Family Events"

# Airtable tables for the OpenAI + Airtable source workflow. These names are
# separate from the legacy AIRTABLE_SOURCES_TABLE default above.
AIRTABLE_EVENT_SOURCES_TABLE="Event Sources"
AIRTABLE_SOURCE_RESEARCH_RUNS_TABLE="Source Research Runs"
AIRTABLE_SOURCE_CANDIDATES_TABLE="Source Candidates"
AIRTABLE_EVENT_CANDIDATES_TABLE="Event Candidates"
# Optional: Airtable Interface for human review (see docs/SACFAM_AIRTABLE_INTERFACE_SETUP.md)
AIRTABLE_INTERFACE_ID=""
AIRTABLE_INTERFACE_URL=""
